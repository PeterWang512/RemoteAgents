# Copy to local.env (git-ignored) and edit. Sourced by start.sh.

# Directory containing bin/node (Node >= 22). Leave unset to use `node` on PATH.
# e.g. made with:  micromamba create -p /path/to/envs/node22 -c conda-forge nodejs=22
NODE_HOME=/data/vision/torralba/u/shengyu/envs/node22

# Where the private socket goes. Must be on LOCAL disk (not AFS/NFS).
# SOCK_DIR=/tmp/cloudcli-$USER

# Voice (speech-to-text). up.sh appends a random STT_API_KEY to local.env.
# STT_PORT=8765
# STT_MODEL=large-v3-turbo     # faster-whisper model; smaller = faster (e.g. small.en)
# STT_THREADS=16

# Public HTTPS entry through the device gate (self-signed cert in ~/.cloudcli/tls). Unset = private only.
# PUBLIC_PORT=8443
